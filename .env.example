# LoreonLabs — environment variables
#
# This phase ships no live integrations. These keys are placeholders for the
# planned data providers (see lib/integrations.ts). Copy to `.env.local` and
# fill in when integration work begins. None are required to build or run the
# landing page, product platform, or documentation.

# Tavily — real-time web search and retrieval
TAVILY_API_KEY=

# Jina AI — web reading, extraction, and embeddings
JINA_API_KEY=

# Reddit — community discussion and sentiment
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GitHub — developer activity and repository signals
GITHUB_TOKEN=

# CoinGecko — market data and attention metrics
COINGECKO_API_KEY=
