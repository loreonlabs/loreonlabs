# LoreonLabs — environment variables
#
# Copy to `.env.local` for local development. None are required to build or run
# the landing page, product platform, or documentation.

# ----------------------------------------------------------------------------
# Subdomain routing (see lib/urls.ts + proxy.ts)
# ----------------------------------------------------------------------------
# Root domain used to derive the app/docs subdomains and cross-zone links.
# Defaults to "loreonlabs.xyz". Override for custom domains or staging.
# In development the app uses *.localhost automatically (NODE_ENV !== production).
NEXT_PUBLIC_ROOT_DOMAIN=loreonlabs.xyz

# ----------------------------------------------------------------------------
# Planned data providers — placeholders (see lib/integrations.ts)
# Not connected in this phase.
# ----------------------------------------------------------------------------

# Tavily — real-time web search and retrieval
TAVILY_API_KEY=

# Jina AI — web reading, extraction, and embeddings
JINA_API_KEY=

# Reddit — community discussion and sentiment
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# GitHub — developer activity and repository signals
GITHUB_TOKEN=

# CoinGecko — market data and attention metrics
COINGECKO_API_KEY=
